# ============================================================================
# Dispatch v3.0 Configuration
# Copy this file to .env and fill in your values
# ============================================================================

# Environment
NODE_ENV=development

# Server
PORT=5500
FRONTEND_URL=http://localhost:5173

# Session Security (generate with: openssl rand -hex 64)
SESSION_SECRET=your-secure-session-secret-here

# ============================================================================
# OAuth Providers (Optional - for Gmail/Outlook sending)
# ============================================================================

# Google OAuth (Gmail API)
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5500/auth/google/callback

# Microsoft OAuth (Outlook/365)
# Get credentials: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5500/auth/microsoft/callback

# ============================================================================
# SMTP Configuration (Optional - for traditional SMTP sending)
# ============================================================================

# Default SMTP settings (users can also configure their own)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=

# ============================================================================
# Notification Service (Optional - for campaign completion emails)
# ============================================================================

NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASS=
NOTIFICATION_FROM_NAME=Email Campaign Notifications

# ============================================================================
# Cloudflare Tracking Worker (Optional - for email open/click tracking)
# ============================================================================

# Your deployed Worker URL (after running: cd tracking-worker && bun run deploy)
# Example: https://dispatch-tracker.your-subdomain.workers.dev
# Enables: open/click tracking, one-click unsubscribe, bounce webhooks
TRACKING_WORKER_URL=

# ============================================================================
# Base URL (Optional - defaults to http://localhost:PORT)
# ============================================================================
BASE_URL=http://localhost:5500
